# ==============================================================================
# PHOTOBOOTH STUDIO BACKEND — ENVIRONMENT VARIABLES TEMPLATE (3-TIER ARCHITECTURE)
# ==============================================================================

# Backend API Port (Default 5000 to avoid collision with Next.js on 3000)
PORT=5000
NODE_ENV=development

# Admin Authorization Key for /api/v1/admin/*
ADMIN_SECRET_KEY=zumppi_admin_secret_key_2026

# Session Security & Encryption Secret
SESSION_SECRET=photobooth_crypto_session_secret_2026
SESSION_RETENTION_HOURS=24

# Security & CORS Whitelist (Comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000

# Rate Limiting (Anti-Spam & DDoS Protection)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=400

# Canva Connect API Credentials (Server-Side Proxy Only)
CANVA_ACCESS_TOKEN=your_canva_connect_access_token_here
CANVA_API_BASE_URL=https://api.canva.com/rest/v1
