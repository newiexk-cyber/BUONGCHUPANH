# ==============================================================================
# PHOTOBOOTH STUDIO BACKEND — ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env and configure your secrets before running in production.
# ==============================================================================

# Server Network Settings
PORT=3000
NODE_ENV=development

# Session Encryption Secret
SESSION_SECRET=replace_with_a_secure_cryptographic_random_string_2026

# Security & CORS Whitelist (Comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://newiexk-cyber.github.io

# Rate Limiting (Anti-Spam & DDoS Protection)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300

# Canva Connect API Credentials (Server-Side Proxy Only)
# Register your app at: https://www.canva.com/developers/
CANVA_ACCESS_TOKEN=your_canva_connect_access_token_here
CANVA_API_BASE_URL=https://api.canva.com/rest/v1

# Storage Paths
PHOTO_STORAGE_PATH=./backend/storage/photos
