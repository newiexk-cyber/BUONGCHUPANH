# Rate Limiting (Chống Spam / DDoS)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300

# Canva Connect API Credentials (Bảo mật ở Backend)
CANVA_ACCESS_TOKEN=OC-AaBH-ZfHBN78
CANVA_API_BASE_URL=https://api.canva.com/rest/v1

# Storage Paths
PHOTO_STORAGE_PATH=./saved_photos
